# ============================================================
# .env.example — Template Environment Variables VeloraSec
# ============================================================
# Salin file ini:  copy .env.example .env
# Edit .env sesuai konfigurasi lokal kamu. JANGAN commit .env ke git.
# ============================================================

# --- Flask ---
FLASK_APP=app
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=ganti-ini-dengan-string-panjang-dan-acak

# --- Database MySQL (XAMPP) ---
# Pastikan MySQL XAMPP sudah berjalan (Start di XAMPP Control Panel)
# Buat database 'velorasec' dulu di phpMyAdmin sebelum menjalankan migrasi
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=velorasec

# --- JWT ---
JWT_SECRET_KEY=ganti-ini-juga-dengan-string-lain-yang-panjang-dan-acak
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# --- CORS ---
# Origins yang diizinkan untuk mengakses API (pisahkan dengan koma, tanpa spasi)
# Sesuaikan port dengan Live Server VS Code kamu (biasanya 5500)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
