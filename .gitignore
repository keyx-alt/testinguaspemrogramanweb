# ============================================================
#  VeloraSec — .gitignore
#  Stack: Python Flask + MySQL + HTML/CSS/JS
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
.venv/
.env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# ── Flask / Web ──────────────────────────────────────────────
instance/
.webassets-cache
flask_session/

# ── Environment & Secrets ────────────────────────────────────
.env
.env.local
.env.production
.env.*.local
*.secret
secrets.json

# ── Database ─────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.sql.bak
mysql_data/

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
log/

# ── IDE & Editor ─────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Node (future tooling) ────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# ── Testing ──────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ── Archives ─────────────────────────────────────────────────
*.zip
*.tar.gz
*.rar
*.7z

# ── Misc ─────────────────────────────────────────────────────
.cache/
*.bak
*.tmp
*.temp
